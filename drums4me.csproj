<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net11.0-windows7.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks><!-- für den Quellgenerator von LibraryImport -->

    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>false</UseWPF>

    <RootNamespace>Drums4me</RootNamespace>

    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0</AssemblyVersion>
    <FileVersion>1.0.0</FileVersion>
    <Product>drums4me</Product>
    <Description>Step-Sequencer und Metronom</Description>
    <Authors>Wilhelm Happe</Authors>
    <Copyright>© 2026 Wilhelm Happe</Copyright>

    <ApplicationIcon>drums4me.ico</ApplicationIcon>

    <Platforms>AnyCPU;x64</Platforms>
    
    <DisableWinExeOutputInference>true</DisableWinExeOutputInference>

    <!-- Deutsch ist einkompiliert, Englisch kommt als Satellit en\drums4me.resources.dll (Languages\lng.en.resx) -->
    <SatelliteResourceLanguages>de;en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="drums4me.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="3.3.0" />
  </ItemGroup>

  <!-- Übersetzungen prüfen (check-lng.ps1): fehlende und verwaiste Einträge. Im Release-Build sind Funde Fehler. -->
  <Target Name="CheckTranslations" AfterTargets="Build">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\check-lng.ps1&quot;" Condition="'$(Configuration)' != 'Release'" />
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\check-lng.ps1&quot; -Strict" Condition="'$(Configuration)' == 'Release'" />
  </Target>

</Project>