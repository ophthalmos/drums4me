<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net11.0-windows7.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>false</UseWPF>

    <RootNamespace>Drums4me</RootNamespace>

    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0</AssemblyVersion>
    <FileVersion>1.0.0</FileVersion>
    <Product>drums4me</Product>
    <Description>Step-Sequencer und Metronom</Description>
    <Authors>Wilhelm Happe</Authors>
    <Copyright>© 2026 Wilhelm Happe</Copyright>

    <ApplicationIcon>drums4me.ico</ApplicationIcon>

    <Platforms>AnyCPU;x64</Platforms>
    
    <DisableWinExeOutputInference>true</DisableWinExeOutputInference>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="drums4me.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="3.3.0" />
  </ItemGroup>

</Project>